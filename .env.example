# ==============================================================================
# Autonomous Agency OS — Environment Configuration Template (.env.example)
# DO NOT COMMIT REAL SECRETS OR KEYS TO THIS REPOSITORY
# Copy this file to .env.local for development
# ==============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# n8n Asynchronous Workflow Engine
N8N_WEBHOOK_URL="https://n8n.yourdomain.com/webhook/audit-job"
N8N_WEBHOOK_HMAC_SECRET="your-cryptographic-hmac-secret-min-32-chars"

# External Google PageSpeed Insights API (Optional: Mock fixtures used if empty)
GOOGLE_PAGESPEED_API_KEY=""

# Application Environment
NODE_ENV="development"
