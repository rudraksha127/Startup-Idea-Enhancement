# ==============================================================================
# AgencyOS — Full-Stack SaaS Environment Configuration (.env.example)
# ==============================================================================

# Database Connection (MongoDB)
MONGODB_URI="mongodb://127.0.0.1:27017/agencyos"

# Authentication & Security
JWT_SECRET="replace-with-a-secure-random-32-byte-secret-for-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Integrations & Providers (defaults to robust mock providers when keys omitted)
AI_RESEARCH_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

EMAIL_PROVIDER="mock"
RESEND_API_KEY=""

MAPS_PROVIDER="mock"
GOOGLE_MAPS_API_KEY=""
