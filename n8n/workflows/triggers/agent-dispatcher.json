{
  "name": "AgencyOS - Central Agent Dispatcher (WF-AGENT-DISPATCHER)",
  "nodes": [
    {
      "parameters": {
        "path": "agent-dispatcher",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-dispatcher-webhook",
      "name": "Dispatcher Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "wh-agent-dispatcher"
    },
    {
      "parameters": {
        "jsCode": "// 1. Validate Dispatch Request Contract\nconst body = $input.first().json.body || $input.first().json;\nif (!body.agentId) {\n  throw new Error('agentId is required to dispatch execution');\n}\n\nconst executionId = 'exec_' + body.agentId + '_' + Date.now().toString(36);\nreturn [{\n  json: {\n    executionId,\n    agentId: body.agentId,\n    payload: body.payload || {},\n    tenantId: body.tenantId || 'default-tenant',\n    status: 'QUEUED',\n    dispatchedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "node-dispatcher-validate",
      "name": "Validate & Generate Execution ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "workflowId": "={{ 'wf-agencyos-' + $json.agentId }}",
        "options": {}
      },
      "id": "node-dispatcher-exec-agent",
      "name": "Invoke Target Agent Workflow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Dispatcher Webhook": {
      "main": [[{ "node": "Validate & Generate Execution ID", "type": "main", "index": 0 }]]
    },
    "Validate & Generate Execution ID": {
      "main": [[{ "node": "Invoke Target Agent Workflow", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "id": "wf-agent-dispatcher",
  "meta": {
    "role": "Central Agent Orchestrator",
    "version": "1.0.0"
  }
}
