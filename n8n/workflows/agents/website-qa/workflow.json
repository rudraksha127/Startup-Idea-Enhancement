{
  "name": "AgencyOS - Website QA Agent",
  "nodes": [
    {
      "parameters": {
        "path": "website-qa",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-website-qa-trigger",
      "name": "Webhook Inbound Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "wh-website-qa"
    },
    {
      "parameters": {
        "jsCode": "// Validate input parameters against contract\nconst payload = $input.first().json.body || $input.first().json;\nif (!payload) {\n  throw new Error(\"Missing payload for Website QA Agent\");\n}\nreturn [{ json: { ...payload, validatedAt: new Date().toISOString(), agent: \"website-qa\" } }];"
      },
      "id": "node-website-qa-validate",
      "name": "Validate Input Contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "model": "gemini-2.0-flash",
        "prompt": "You are the Website QA Agent for AgencyOS. Execute the following task: Verifies cross-browser layouts, form validation, and responsiveness before deploy. Input: {{ JSON.stringify($json) }}. Return strictly structured JSON."
      },
      "id": "node-website-qa-ai-core",
      "name": "AI Autonomous Execution",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.4,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.AGENCYOS_API_URL || 'http://localhost:4000' }}/api/v1/n8n/webhook/lead-audit",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "agentId",
              "value": "website-qa"
            },
            {
              "name": "result",
              "value": "={{ $json }}"
            },
            {
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-website-qa-callback",
      "name": "AgencyOS Backend Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Inbound Trigger": {
      "main": [
        [
          {
            "node": "Validate Input Contract",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Input Contract": {
      "main": [
        [
          {
            "node": "AI Autonomous Execution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Autonomous Execution": {
      "main": [
        [
          {
            "node": "AgencyOS Backend Callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "versionId": "1.0.0",
  "id": "wf-agencyos-website-qa",
  "meta": {
    "agentId": "website-qa",
    "agentName": "Website QA Agent",
    "category": "Quality Assurance",
    "tools": [
      "playwright_test_runner",
      "broken_links_checker",
      "accessibility_wcag_audit"
    ],
    "defaultInputs": {
      "stagingUrl": "https://staging.agencyos.io/demo"
    },
    "outputSchema": {
      "testSuiteStatus": "string",
      "passedTests": "number",
      "failedTests": "number",
      "criticalBugs": "array"
    }
  }
}