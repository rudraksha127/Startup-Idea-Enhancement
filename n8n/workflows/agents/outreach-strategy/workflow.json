        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-outreach-strategy-trigger",
      "name": "Webhook Inbound Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "wh-outreach-strategy"
    },
    {
      "parameters": {
        "jsCode": "// Validate input parameters against contract\nconst payload = $input.first().json.body || $input.first().json;\nif (!payload) {\n  throw new Error(\"Missing payload for Outreach Strategy Agent\");\n}\nreturn [{ json: { ...payload, validatedAt: new Date().toISOString(), agent: \"outreach-strategy\" } }];"
      },
      "id": "node-outreach-strategy-validate",
      "name": "Validate Input Contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "model": "gemini-2.0-flash",
        "prompt": "You are the Outreach Strategy Agent for AgencyOS. Execute the following task: Personalizes outreach sequences based on website audit signals and business profiles. Input: {{ JSON.stringify($json) }}. Return strictly structured JSON."
      },
      "id": "node-outreach-strategy-ai-core",
      "name": "AI Autonomous Execution",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.4,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
