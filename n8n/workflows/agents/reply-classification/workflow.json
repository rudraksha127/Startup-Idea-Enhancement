{
  "name": "AgencyOS - Reply Classification Agent",
  "nodes": [
    {
      "parameters": {
        "path": "reply-classification",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-reply-classification-trigger",
      "name": "Webhook Inbound Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "wh-reply-classification"
    },
    {
      "parameters": {
        "jsCode": "// Validate input parameters against contract\nconst payload = $input.first().json.body || $input.first().json;\nif (!payload) {\n  throw new Error(\"Missing payload for Reply Classification Agent\");\n}\nreturn [{ json: { ...payload, validatedAt: new Date().toISOString(), agent: \"reply-classification\" } }];"
      },
      "id": "node-reply-classification-validate",
      "name": "Validate Input Contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "model": "gemini-2.0-flash",
        "prompt": "You are the Reply Classification Agent for AgencyOS. Execute the following task: Monitors inbox replies, categorizes intent, detects objections, and schedules meetings. Input: {{ JSON.stringify($json) }}. Return strictly structured JSON."
      },
      "id": "node-reply-classification-ai-core",
      "name": "AI Autonomous Execution",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.4,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.AGENCYOS_API_URL || 'http://localhost:4000' }}/api/v1/n8n/webhook/lead-audit",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "agentId",
              "value": "reply-classification"
            },
            {
              "name": "result",
              "value": "={{ $json }}"
            },
            {
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-reply-classification-callback",
      "name": "AgencyOS Backend Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Inbound Trigger": {
      "main": [
        [
          {
            "node": "Validate Input Contract",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Input Contract": {
      "main": [
        [
          {
            "node": "AI Autonomous Execution",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Autonomous Execution": {
      "main": [
        [
          {
            "node": "AgencyOS Backend Callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "versionId": "1.0.0",
  "id": "wf-agencyos-reply-classification",
  "meta": {
    "agentId": "reply-classification",
    "agentName": "Reply Classification Agent",
    "category": "Communication",
    "tools": [
      "intent_nlp_classifier",
      "dnc_optout_filter"
    ],
    "defaultInputs": {
      "replyText": "Sounds interesting, can we talk Thursday?",
      "leadEmail": "owner@cafe.in"
    },
    "outputSchema": {
      "intent": "string",
      "confidence": "number",
      "requiresHumanReview": "boolean"
    }
  }
}