{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@agencyos/contracts": ["../packages/contracts/src/index.ts"],
      "@agencyos/contracts/*": ["../packages/contracts/src/*"],
      "@agencyos/validation": ["../packages/validation/src/index.ts"],
      "@agencyos/validation/*": ["../packages/validation/src/*"],
      "@agencyos/config": ["../packages/config/src/index.ts"],
      "@agencyos/config/*": ["../packages/config/src/*"],
      "@agencyos/utils": ["../packages/utils/src/index.ts"],
      "@agencyos/utils/*": ["../packages/utils/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "prototype"]
}

