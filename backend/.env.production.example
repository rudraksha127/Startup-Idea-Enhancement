# ========================================================
# AgencyOS Backend API — Production Environment Variables
# Target: Zoho Catalyst AppSail (Node.js 20)
# ========================================================

PORT=4000
NODE_ENV=production

# Frontend Origin for strict CORS protection
CORS_ORIGIN=https://agencyos-saas.pages.dev

# JWT Secret for Session & API Token signing (min 32 chars)
JWT_SECRET=production_jwt_secret_change_this_to_a_random_32_char_string!

# Zoho Catalyst Project Configuration (Auto-injected by Zoho AppSail at runtime)
# ZCATALYST_PROJECT_ID=
# ZCATALYST_ENVIRONMENT=production

# Stripe Billing & Webhook Security
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# Google Maps Platform API (Places API & Geocoding)
GOOGLE_MAPS_API_KEY=AIzaSy_your_google_maps_platform_api_key

# Multi-Provider AI LLM Gateway
GEMINI_API_KEY=AIzaSy_your_gemini_api_key
OPENAI_API_KEY=sk-proj_your_openai_api_key

# n8n Automation Engine Webhook
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook
N8N_API_KEY=your_n8n_api_key

# Transactional Email Engine
RESEND_API_KEY=re_your_resend_api_key
