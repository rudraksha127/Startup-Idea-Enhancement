{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@agencyos/contracts": ["../packages/contracts/src/index.ts"],
      "@agencyos/validation": ["../packages/validation/src/index.ts"],
      "@agencyos/config": ["../packages/config/src/index.ts"],
      "@agencyos/utils": ["../packages/utils/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
